{
  "$schema": "https://opencode.ai/config.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "keybinds": {
    "agent.cycle": "shift+tab",
    "model.cycle_favorite": "<leader>f",
    "model.cycle_favorite_reverse": "<leader>F",
    "session.toggle.thinking": "<leader>t"
  },
  "animations": true
}
